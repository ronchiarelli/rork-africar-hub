{
  "expo": {
    "name": "GoCar Hub",
    "slug": "gocar-hub",
    "version": "1.0.15",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gocarhub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gocarhub.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.gocarhub.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF6B2C",
          "sounds": ["./assets/sounds/car_horn.wav"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GoCar Hub uses your camera to take a selfie photo for identity verification."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GoCar Hub accesses your photo library so you can choose pictures to upload — for example, adding photos when listing a car for rent or sale, setting your profile picture, or attaching an image to a support issue report.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "25c6a156-ed97-4b53-89dc-847f91abd287"
      }
    },
    "owner": "ronchiarelli"
  }
}
